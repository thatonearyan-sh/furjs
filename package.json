{
  "name": "@thatonearyan/furjs",
  "version": "1.0.0",
  "description": "The Universal Interactive Living Fur Typography Engine — photorealistic, physics-driven fur for any text, font or glyph on HTML5 Canvas 2D. Zero dependencies.",
  "keywords": [
    "fur",
    "typography",
    "canvas",
    "physics",
    "creative-coding",
    "generative-art",
    "text-effects",
    "webgl-alternative",
    "luxury",
    "pelts",
    "react",
    "nextjs"
  ],
  "author": "thatonearyan <https://github.com/thatonearyan-sh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatonearyan-sh/furjs.git"
  },
  "homepage": "https://github.com/thatonearyan-sh/furjs#readme",
  "bugs": {
    "url": "https://github.com/thatonearyan-sh/furjs/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/thatonearyan-sh"
  },
  "contributors": [
    "thatonearyan <https://github.com/thatonearyan-sh>"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "alternativenames": [
    "@thatanearyan/fur"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/Fur.d.ts",
      "import": "./dist/react/Fur.js",
      "require": "./dist/react/Fur.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "furjs": "bin/cli.js",
    "fur": "bin/cli.js"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "tsup": "^8.0.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.14.1",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin",
    "lint:fix": "eslint src bin --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "playground": "node ./bin/cli.js",
    "size": "gzip -c dist/index.js | wc -c && echo \"bytes gzipped (must be <30720)\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
